# Neon PostgreSQL Database Connection URL (from Neon Console -> Project -> Connection Details)
# Example: postgresql://<user>:<password>@ep-silent-sea-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for authenticating sessions (generate a 64+ char random string for production)
JWT_SECRET="generate-a-secure-random-secret-key-at-least-32-chars-long"

# Server Port (Render provides this automatically; fallback for local dev is 4000)
PORT=4000

# Web Client URL for CORS policy (comma-separated allowed origins or your deployed web frontend URL)
CLIENT_URL="https://your-frontend.vercel.app,http://localhost:5173"

# Node Environment: production | development
NODE_ENV="development"

