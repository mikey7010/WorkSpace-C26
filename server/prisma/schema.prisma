generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("dept_head") // hr_admin, dept_head, supervisor, member
  designation  String?
  phone        String?
  departmentId Int?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?

  department       Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headedDepartment Department?    @relation("DepartmentHead")
  assignedTasks    Task[]         @relation("AssignedTo")
  createdTasks     Task[]         @relation("CreatedBy")
  dailyLogs        DailyWorkLog[]
  directives       HrDirective[]  @relation("DirectiveAuthor")
  comments         Comment[]
  activityLogs     ActivityLog[]
  ownedHiringCandidates HiringCandidate[] @relation("HiringCandidateOwner")
}

model Department {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  code            String    @unique
  description     String?
  headId          Int?      @unique
  targetManpower  Int       @default(25)
  currentManpower Int       @default(20)
  createdAt       DateTime  @default(now())

  head         User?          @relation("DepartmentHead", fields: [headId], references: [id])
  members      User[]         @relation("DepartmentMembers")
  workLogs     DailyWorkLog[]
  tasks        Task[]
  demands      ClientDemand[]
  candidates   Candidate[]
  directives   HrDirective[]
  hiringPositions HiringPosition[]
}

model ManpowerPlan {
  id             Int      @id @default(autoincrement())
  dept           String
  subDept        String?
  position       String
  plannedTotal   Int      @default(1)
  sep            Int      @default(0)
  oct            Int      @default(0)
  nov            Int      @default(0)
  dec            Int      @default(0)
  jan            Int      @default(0)
  feb            Int      @default(0)
  mar            Int      @default(0)
  apr            Int      @default(0)
  may            Int      @default(0)
  total          Int      @default(0)
  remarks        String?
  status         String   @default("planned") // appointed, sourcing, discussion, pending_doi, planned
  appointedNames String?
  createdAt      DateTime @default(now())
}

model DailyWorkLog {
  id               Int      @id @default(autoincrement())
  departmentId     Int
  reportedById     Int
  shiftDate        DateTime @default(now())
  shift            String   @default("Day Shift") // Day Shift, Night Shift, General
  targetOutput     Int      @default(0)
  actualOutput     Int      @default(0)
  manpowerPresent  Int      @default(0)
  manpowerRequired Int      @default(0)
  status           String   @default("On Schedule") // On Schedule, Delayed, Halted, Ahead
  blockers         String?
  notes            String?
  createdAt        DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  reportedBy User       @relation(fields: [reportedById], references: [id])
  comments   Comment[]
}

model ClientDemand {
  id                   Int       @id @default(autoincrement())
  clientName           String
  jobProfile           String    // e.g. "10 Production Engineers", "Floor Supervisors"
  departmentId         Int?
  requiredCount        Int       @default(10)
  targetDeploymentDate DateTime? // e.g. Jan 2027
  sourcingMonth        String    @default("October")
  interviewMonth       String    @default("November")
  consultationMonth    String    @default("December")
  currentPhase         String    @default("Sourcing (Oct)") // Sourcing, Interviews, Consultation, Onboarding, Completed
  status               String    @default("Active") // Active, Completed, Paused
  budgetPerRole        String?
  notes                String?
  createdAt            DateTime  @default(now())

  department Department? @relation(fields: [departmentId], references: [id])
  candidates Candidate[]
}

model Candidate {
  id                   Int       @id @default(autoincrement())
  clientDemandId       Int?
  departmentId         Int?
  name                 String
  email                String
  phone                String?
  appliedRole          String
  currentStage         String    @default("Applied") // Sourced, Interview, Consultation, Offered, Onboarding, Joined, Rejected
  interviewDate        DateTime?
  consultationDate     DateTime?
  joiningDate          DateTime?
  expectedSalary       String?
  offeredSalary        String?
  onboardingProgress   Int       @default(0) // 0 to 100%
  docVerification      Boolean   @default(false)
  bgvCheck             Boolean   @default(false)
  safetyInductionDone  Boolean   @default(false)
  workstationAssigned  Boolean   @default(false)
  mentorAssigned       Boolean   @default(false)
  notes                String?
  createdAt            DateTime  @default(now())

  clientDemand ClientDemand? @relation(fields: [clientDemandId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  comments     Comment[]
}

model HrDirective {
  id                 Int       @id @default(autoincrement())
  authorId           Int
  title              String
  content            String
  category           String    @default("Recruitment Milestone") // Recruitment Milestone, Policy Update, Shift Notice, Urgent Request
  priority           String    @default("Normal") // Normal, High, Urgent
  targetDepartmentId Int?      // null = all 10 departments
  createdAt          DateTime  @default(now())

  author           User        @relation("DirectiveAuthor", fields: [authorId], references: [id])
  targetDepartment Department? @relation(fields: [targetDepartmentId], references: [id])
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  assignedTo   Int
  createdBy    Int
  departmentId Int?
  priority     String    @default("medium") // low, medium, high
  status       String    @default("todo")   // todo, inprog, review, done
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  assignee   User        @relation("AssignedTo", fields: [assignedTo], references: [id])
  creator    User        @relation("CreatedBy",  fields: [createdBy],  references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  comments   Comment[]
}

model Comment {
  id             Int       @id @default(autoincrement())
  taskId         Int?
  candidateId    Int?
  dailyWorkLogId Int?
  userId         Int
  text           String
  createdAt      DateTime  @default(now())

  task      Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  candidate Candidate?    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  workLog   DailyWorkLog? @relation(fields: [dailyWorkLogId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ---------------- RECRUITMENT MANAGEMENT (Work Plan / Summary / Candidate Tracking) ----------------
// Source of truth:
//   HiringPosition  = recruitment requirement (Dept + Position + No. of workers needed)
//   HiringPeriod    = configured planning months (columns of the Work Plan)
//   HiringMonth     = HOD requirement + remarks for one requirement in one month
//   HiringCandidate = one row per person HR selects; stage/status tracked per candidate
// HR-selected counts, stage counts, joined and balance are always CALCULATED from HiringCandidate.

model HiringPosition {
  id           Int               @id @default(autoincrement())
  dept         String
  position     String
  totalNeed    Int               @default(0) // No. of workers needed (approved total)
  sortOrder    Int               @default(0)
  departmentId Int?              // link to Department → which HOD may edit it
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  department   Department?       @relation(fields: [departmentId], references: [id])
  months       HiringMonth[]
  candidates   HiringCandidate[]

  @@unique([dept, position, sortOrder])
  @@index([dept])
  @@index([position])
  @@index([departmentId])
}

model HiringPeriod {
  id        Int      @id @default(autoincrement())
  month     String   @unique // YYYY-MM
  year      Int
  monthNum  Int
  createdBy String?
  createdAt DateTime @default(now())

  @@index([year])
}

model HiringMonth {
  id               Int            @id @default(autoincrement())
  positionId       Int
  month            String         // YYYY-MM
  hodCount         Int            @default(0) // HOD requirement for this month
  remarks          String?
  allowExceed      Boolean        @default(false) // HR Head approved selecting more than HOD requirement
  exceedApprovedBy String?
  exceedNote       String?
  // Legacy aggregate columns from the first Excel import. No longer used for counting —
  // they were converted into individual HiringCandidate rows. Kept so no data is lost.
  hrCount          Int            @default(0)
  sourcing         Int            @default(0)
  onboarding       Int            @default(0)
  offerIssued      Int            @default(0)
  joined           Int            @default(0)
  joiningDate      String?
  updatedBy        String?
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())

  position HiringPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, month])
  @@index([month])
}

model HiringCandidate {
  id                  Int                      @id @default(autoincrement())
  positionId          Int                      // recruitment requirement
  plannedMonth        String                   // YYYY-MM the candidate is currently allocated to
  originalMonth       String                   // YYYY-MM first allocated to (never changes)
  name                String
  phone               String?
  email               String?
  ownerId             Int?                     // HR executive responsible
  stage               String                   @default("sourcing") // sourcing | onboarding | offer_issued | joining
  status              String                   @default("active")   // active | on_hold | rejected | withdrawn | joined
  sourcingDate        DateTime?
  sourceDetails       String?
  onboardingDate      DateTime?
  onboardingProgress  Int                      @default(0)
  offerIssuedDate     DateTime?
  offerStatus         String?                  // pending | accepted | declined
  expectedJoiningDate DateTime?
  actualJoiningDate   DateTime?
  remarks             String?
  createdById         Int?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  position HiringPosition           @relation(fields: [positionId], references: [id])
  owner    User?                    @relation("HiringCandidateOwner", fields: [ownerId], references: [id])
  history  HiringCandidateHistory[]

  @@index([positionId, plannedMonth])
  @@index([plannedMonth])
  @@index([status])
  @@index([stage])
  @@index([ownerId])
}

model HiringCandidateHistory {
  id          Int             @id @default(autoincrement())
  candidateId Int
  action      String          // created | stage | status | planned_month | details
  fromValue   String?
  toValue     String?
  note        String?
  userId      Int?
  userName    String?
  createdAt   DateTime        @default(now())

  candidate HiringCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

// Audit trail for requirement / month / period changes
model HiringAudit {
  id         Int      @id @default(autoincrement())
  entity     String   // requirement | month | period | system
  entityId   Int?
  positionId Int?
  month      String?
  field      String
  oldValue   String?
  newValue   String?
  userId     Int?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([positionId])
  @@index([entity, field])
}
